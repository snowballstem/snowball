// Latvian light stemmer.
//
// Based on the algorithm in Kārlis Krēsliņš, "A stemming algorithm for
// Latvian", PhD thesis, Loughborough University, 1996, in the light form
// implemented by Lucene's LatvianStemmer: only the inflectional endings of
// nouns and adjectives (case, number, gender, definiteness) are removed, and
// the consonant alternations of declensions II, V and VI (brālis -> brāļi,
// zivs -> zivju) are undone after the endings which cause them.

routines (
    mark_regions
    ending
    unpalatalize
    unpalatalize_u
)

externals ( stem )

integers ( p1 x )

groupings ( v labial )

stringescapes {}

stringdef a-   '{U+0101}'
stringdef cv   '{U+010D}'
stringdef e-   '{U+0113}'
stringdef i-   '{U+012B}'
stringdef lc   '{U+013C}'
stringdef nc   '{U+0146}'
stringdef sv   '{U+0161}'
stringdef u-   '{U+016B}'
stringdef zv   '{U+017E}'

define v 'aeiou{a-}{e-}{i-}{u-}'
define labial 'bmpv'

// The stem left after removing an ending must be at least three letters
// long and contain a vowel.
define mark_regions as (
    $p1 = limit
    test (hop 3 setmark x)
    gopast v  setmark p1
    try ($p1 < x  $p1 = x)
)

backwardmode (

    // Ambiguous alternations (s, t -> š; d, z -> ž) are not undone.
    define unpalatalize as (
        [substring] among (
            'j'          (labial delete)
            '{sv}{nc}'   (<- 'sn')
            '{zv}{nc}'   (<- 'zn')
            '{sv}{lc}'   (<- 'sl')
            '{zv}{lc}'   (<- 'zl')
            '{lc}{nc}'   (<- 'ln')
            '{lc}{lc}'   (<- 'll')
            '{cv}'       (<- 'c')
            '{lc}'       (<- 'l')
            '{nc}'       (<- 'n')
        )
    )

    // kst -> kš and nn -> ņņ are only undone after -u (genitive plural of
    // declensions II, V and VI) or -us.
    define unpalatalize_u as (
        (
            [substring] among (
                'k{sv}'      (<- 'kst')
                '{nc}{nc}'   (<- 'nn')
            )
        ) or unpalatalize
    )

    define ending as (
        setlimit tomark p1 for ([substring])
        among (
            'ajiem' 'ajai' 'ajam' 'aj{a-}m' 'ajos' 'aj{a-}s' 'aj{a-}'
            'ais' 'ai' 'ei'
            '{a-}m' 'am' '{e-}m' '{i-}m' 'im' 'um'
            'as' '{a-}s' 'es' '{e-}s' 'is' '{i-}s' 'ij' 'ie'
            'e' 'o' '{a-}' '{e-}' '{i-}' '{u-}' 's' '{sv}'
                (delete)
            'iem' 'os' 'a' 'i'
                (delete try unpalatalize)
            'us' 'u'
                (delete try unpalatalize_u)
        )
    )
)

define stem as (
    do mark_regions
    backwards do ending
)
