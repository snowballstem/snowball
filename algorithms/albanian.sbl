        'shuakeshim' 'shuakeshin' 'shuakeshit' 'shuam' 'shuar' 'shuhemi'
        'shuhesh'
            (<- 'shu')
        'skllever' 'sklleverit' 'sklleverve'
            (<- 'skllav')
        'sill' 'sillej' 'sillem' 'sillemi' 'sillen' 'silleni' 'sillesh'
        'sillesha' 'silleshe' 'silleshim' 'silleshin' 'silleshit' 'sillet'
        'sillja' 'sillje' 'sillni' 'sillnim' 'sillnin' 'sillnit' 'sillte'
        'sjell' 'sjelle' 'sjellesh' 'sjellim' 'sjellin' 'sjellka' 'sjellkam'
        'sjellkan' 'sjellke' 'sjellkej' 'sjellkemi' 'sjellkeni' 'sjellkesha'
        'sjellkeshe' 'sjellkeshim' 'sjellkeshin' 'sjellkeshit' 'sjellsh'
        'sjellsha' 'sjellshi' 'sjellshim' 'sjellshin' 'sjellte'
            (<- 'soll')
        'thase' 'thaset'
            (<- 'the')
        'therrasesh' 'therrasim' 'therrasin' 'therrisja' 'therrisje' 'therrisni'
        'therrisnim' 'therrisnin' 'therrisnit' 'therriste' 'therrita'
        'therritem' 'therritemi' 'therriten' 'therriteni' 'therritesh'
        'therritesha' 'therriteshe' 'therriteshim' 'therriteshin' 'therriteshit'
        'therritet' 'therriti' 'therritka' 'therritkam' 'therritkan' 'therritke'
        'therritkej' 'therritkemi' 'therritkeni' 'therritkesha' 'therritkeshe'
        'therritkeshim' 'therritkeshin' 'therritkeshit' 'therritni' 'therritsh'
        'therritsha' 'therritshi' 'therritshim' 'therritshin' 'therritte'
        'therritur' 'thirra' 'thirrej' 'thirren' 'thirret' 'thirrur'
            (<- 'therr')
        'thashe' 'the' 'them' 'themi' 'thenc' 'thenca' 'thenci' 'thencim'
        'thencin' 'thene' 'thenka' 'thenkam' 'thenkan' 'thenke' 'thenkemi'
        'thenkeni' 'thenkesh' 'thenkesha' 'thenkeshe' 'thenkeshim' 'thenkeshin'
        'thenkeshit' 'thente' 'thoja' 'thom' 'thone' 'thoni' 'thonim' 'thonin'
        'thonte' 'thosha' 'thoshe' 'thoshim' 'thoshin' 'thoshit' 'thoshte'
        'thot' 'thuaj' 'thuaja' 'thuaje' 'thuaji' 'thuash' 'thuhej' 'thuhen'
        'thuhet'
            (<- 'thot')
        'thonj' 'thonjve'
            (<- 'thu')
        'tirr' 'tirrja' 'tirrje' 'tirrni' 'tirrnim' 'tirrnin' 'tirrnit' 'tirrte'
        'tjerrim' 'tjerrka' 'tjerrke' 'tjerrkej' 'tjerrkesha' 'tjerrkeshe'
        'tjerrkeshim' 'tjerrkeshin' 'tjerrkeshit' 'tjerrsh' 'tjerrsha'
        'tjerrshi' 'tjerrshim' 'tjerrshin' 'tjerrte' 'tora' 'tore' 'torem'
        'toren'
            (<- 'tjerr')
        'tredhim' 'tredhka' 'tredhke' 'tredhkej' 'tredhkesha' 'tredhkeshe'
        'tredhkeshim' 'tredhkeshin' 'tredhkeshit' 'tredhsh' 'tredhsha'
        'tredhshi' 'tredhshim' 'tredhshin' 'tredhte' 'tridh' 'tridhem'
        'tridhemi' 'tridhen' 'tridheni' 'tridhesh' 'tridhesha' 'tridheshe'
        'tridheshim' 'tridheshin' 'tridheshit' 'tridhet' 'tridhja' 'tridhje'
        'tridhni' 'tridhnim' 'tridhnin' 'tridhnit' 'tridhte' 'trodhem'
            (<- 'tredh')
        'troje' 'trojet' 'trojeve'
            (<- 'truall')
        'vafshim' 'vafte' 'vajta' 'vajte' 'vajtem' 'vajten' 'vajtet' 'vajti'
        'vajtka' 'vajtkam' 'vajtkan' 'vajtke' 'vajtkemi' 'vajtkeni' 'vajtkesh'
        'vajtkesha' 'vajtkeshe' 'vajtkeshim' 'vajtkeshin' 'vajtkeshit' 'vajtur'
        'vata'
            (<- 'vafsh')
        'vdekka' 'vdekkam' 'vdekkan' 'vdekke' 'vdekkemi' 'vdekkeni' 'vdekkesh'
        'vdekkesha' 'vdekkeshe' 'vdekkeshim' 'vdekkeshin' 'vdekkeshit' 'vdeksh'
        'vdeksha' 'vdekshi' 'vdekshim' 'vdekshin' 'vdekte' 'vdekur' 'vdes'
        'vdese' 'vdesesh' 'vdesim' 'vdesin' 'vdis' 'vdisja' 'vdisje' 'vdisni'
        'vdisnim' 'vdisnin' 'vdisnit' 'vdiste'
            (<- 'vdiq')
        'veme' 'venc' 'venca' 'venci' 'vencim' 'vencin' 'venka' 'venkam'
        'venkan' 'venke' 'venkej' 'venkemi' 'venkeni' 'venkesha' 'venkeshe'
        'venkeshim' 'venkeshin' 'venkeshit' 'vume' 'vune' 'vura' 'vure' 'vuri'
            (<- 've')
        'vidhem' 'vidhemi' 'vidhen' 'vidheni' 'vidhesha' 'vidheshe' 'vidheshim'
        'vidheshin' 'vidhja' 'vidhje' 'vidhni' 'vidhnim' 'vidhnin' 'vidhnit'
        'vidhte' 'vjedh' 'vjedhe' 'vjedhesh' 'vjedhim' 'vjedhin' 'vjedhka'
        'vjedhkam' 'vjedhkan' 'vjedhke' 'vjedhkej' 'vjedhkemi' 'vjedhkeni'
        'vjedhkesha' 'vjedhkeshe' 'vjedhkeshim' 'vjedhkeshin' 'vjedhkeshit'
        'vjedhsh' 'vjedhsha' 'vjedhshi' 'vjedhshim' 'vjedhshin' 'vjedhte'
        'vjedhur' 'vodhem'
            (<- 'vedh')
        'vellezer' 'vellezerit' 'vellezerve'
            (<- 'vell')
        'vil' 'vilje' 'vilni' 'vilnin' 'vilnit' 'vilte' 'vjel' 'vjele' 'vjelesh'
        'vjelim' 'vjelin' 'vjelka' 'vjelkam' 'vjelkan' 'vjelke' 'vjelkej'
        'vjelkemi' 'vjelkeni' 'vjelkesha' 'vjelkeshe' 'vjelkeshim' 'vjelkeshin'
        'vjelkeshit' 'vjelsh' 'vjelsha' 'vjelshi' 'vjelshim' 'vjelshin' 'vjelte'
        'volem' 'volet'
            (<- 'vilnim')
        'yje' 'yjesh' 'yjet' 'yjeve'
            (<- 'yll')
        'zbresesh' 'zbresim' 'zbresin' 'zbrisja' 'zbrisje' 'zbrisni' 'zbrisnim'
        'zbrisnin' 'zbrisnit' 'zbriste' 'zbrita' 'zbritem' 'zbriten' 'zbritet'
        'zbriti' 'zbritka' 'zbritkam' 'zbritkan' 'zbritke' 'zbritkej'
        'zbritkemi' 'zbritkeni' 'zbritkesha' 'zbritkeshe' 'zbritkeshim'
        'zbritkeshin' 'zbritkeshit' 'zbritni' 'zbritsh' 'zbritsha' 'zbritshi'
        'zbritshim' 'zbritshin' 'zbritte' 'zbritur'
            (<- 'zbr')
        'zeme' 'zenc' 'zenca' 'zenci' 'zencim' 'zencin' 'zene' 'zenkam' 'zenkan'
        'zenkej' 'zenkemi' 'zenkeni' 'zenkesha' 'zenkeshe' 'zenkeshim'
        'zenkeshin' 'zenkeshit' 'zente' 'zer' 'zesh' 'zija' 'zije' 'zini'
        'zinim' 'zinin' 'zinit' 'zinte' 'zu' 'zume' 'zune' 'zura' 'zure' 'zuri'
        'zute'
            (<- 'ze')
    )
)

define v 'aeiouy'  // after folding, so e also stands for {e"}
define kgh 'kgh'

// R1 is the region after the first 3 letters: no ending is removed
// from them, so a stem keeps at least 3 letters.
// pr1 and pr2 mark the usual Snowball regions (called R1 and R2 in the
// rules file): pr1 after the first non-vowel following a vowel, pr2 the
// same again from pr1. An ending marked InR1 or InR2 must also lie in it.
// An ending marked AfterV or AfterKGH must follow a vowel, or k, g or h,
// itself outside the first letters.
// The other After... and NotAfter... routines test the letters before
// an ending: it must follow one of them (After), or none (NotAfter).
// Each keeps a frequent ending off the stems whose own letters end like
// it; its comment names the ending, a form it takes and one it spares.
define mark_regions as (
    $p1 = limit
    do ( hop 3 setmark p1 )
    $s1 = limit  do ( hop 1 setmark s1 )
    $s2 = limit  do ( hop 2 setmark s2 )
    $pr2 = limit
    do ( gopast v gopast non-v
         gopast v gopast non-v setmark pr2 )
)

backwardmode (

    define R1 as $p1 <= cursor
    define S1 as $s1 <= cursor  // 1 letter precedes
    define S2 as $s2 <= cursor  // 2 letters precede
    define InR2 as ( R1 $pr2 <= cursor )
    define AfterV as ( R1 test v )
    define AfterKGH as ( R1 test kgh )
    // -ra: gjëra, not mënyra
    define AfterE as ( R1 test 'e' )
    // -oj, -oni: punoni, not aksioni
    define NotAfterI as ( R1 not 'i' )
    // -n, -ne, -ni: punojnë, not aksione
    define NotAfterIO as ( R1 not 'io' )
    // -nte, -jta: punonte, mbajti, not dokumente, drejta
    define NotAfterE as ( R1 not 'e' )
    // -ve, not after o or ti: shtëpive, not Kosovë, sportive
    define NotAfterOTI as ( R1 not among ( 'o' 'ti' ) )
    // -hem: lahem, not rëndësishëm
    define NotAfterS as ( R1 not 's' )
    // -jt: artikujt
    define AfterU as ( R1 test 'u' )
    // -em, not after iz, bl or st: hapem, not organizëm, problem, sistem
    define NotAfterIZBLST as ( R1 not among ( 'iz' 'bl' 'st' ) )
    // -së, after a vowel but not je: shtëpisë, not pjesë
    define AfterVNotJE as ( R1 test v not 'je' )
    // -nim, after o or a but not io: punonim, not bashkëpunim, funksionim
    define AfterOANotIO as ( R1 test among ( 'o' 'a' ) not 'io' )
    // shm → sh: rëndësishme, not dëshmi
    define NotAfterAEOUY as ( S1 not among ( 'a' 'e' 'o' 'u' 'y' ) )

    // The longest ending of step1 in R1, if any, is removed.
    define step1 as (
        [substring] among (
            // nouns, masculine: definite and oblique (mali, malin, malit; mjeku, mjekun)
            'i' R1 'u' R1 'in' R1 'it' R1 'un' R1 'ut' R1
            // after a stressed vowel (druri, drurin, drurit)
            'rin' AfterKGH 'rit' AfterKGH
            // nouns, feminine: definite and oblique (molla, mollën, mollës; lulja; shtëpisë)
            'a' R1 'n' NotAfterIO 's' AfterV 'en' R1 'es' R1 'ja' AfterV 'je' AfterV
            'ne' NotAfterIO 'se' AfterVNotJE
            // neuter and plural definite (vitet, mollët, shtëpitë, mollat)
            't' AfterV 'at' R1 'et' R1
            // plural oblique and ablative (mollëve, maleve, fermerësh)
            've' NotAfterOTI 'ash' R1 'ave' R1 'esh' R1 'eve' R1
            // neuter plurals in -ra (plehra, plehrat, plehrave)
            'ra' AfterE 'rat' AfterE 'rash' AfterE 'rave' AfterE
            // verbs, present (punoj, punon, punojmë, punoni, punojnë)
            'j' AfterV 'ej' R1 'ni' NotAfterIO 'oj' NotAfterI 'on' NotAfterI 'eni' R1
            'jme' R1 'jne' R1 'oni' NotAfterI 'ejme' R1 'ejne' R1 'ijme' R1
            'ojme' NotAfterI 'ojne' NotAfterI
            // imperfect (punoja, punonte, punonim, punonin)
            'nim' AfterOANotIO 'nin' NotAfterIO 'nit' NotAfterIO 'nte' NotAfterE
            'oja' AfterV 'oje' NotAfterI 'onim' NotAfterI 'onin' NotAfterI
            'onit' NotAfterI 'onte' NotAfterI
            // aorist (punova, punove, punoi, punuam, punuat, punuan)
            'am' AfterKGH 'an' R1 'oi' R1 'ova' R1 'uam' R1 'uan' R1 'uat' R1
            // participle (punuar, ujitur, mbjellë)
            'ur' R1 'uar' R1
            // non-active (mbillet, mbillen, punohet, punohej)
            'em' NotAfterIZBLST 'emi' NotAfterIZBLST 'hej' R1 'hem' NotAfterS
            'hen' AfterV 'het' AfterV 'ohu' R1 'esha' R1 'eshe' R1 'heni' R1 'ohej' R1
            'ohem' R1 'ohen' R1 'ohet' R1 'eshim' R1 'eshin' R1 'eshit' R1 'hesha' R1
            'heshe' R1 'ohemi' R1 'oheni' R1 'ohesh' R1 'heshim' R1 'heshin' R1
            'heshit' R1 'ohesha' R1 'oheshe' R1 'oheshim' R1 'oheshin' R1 'oheshit' R1
            // optative (punofsha, punoftë)
            'fsh' R1 'ofsh' R1 'ofte' R1 'fshim' R1 'fshin' R1 'fshit' R1 'ofsha' R1
            'ofshim' R1 'ofshin' R1 'ofshit' R1
            // admirative (punuakam, punuaka); not a bare -ka, which is the
            // root's k + -a of banka, maska, marka (hapka keeps its k)
            'kam' R1 'kan' R1 'kane' R1 'kemi' R1 'keni' R1 'uaka' R1
            'uake' R1 'uakam' R1 'uakan' R1 'uakane' R1 'uakemi' R1 'uakeni' R1
            // declined participle (punuara, punuarit), non-active aorist (u punua)
            'ua' R1 'ue' R1 'uem' R1 'uara' R1 'uare' R1 'uari' R1 'uarat' R1 'uarin' R1
            'uarit' R1 'uarve' R1 'uarave' R1 'uaresh' R1
            // the stressed -i of shtëpi, energji, in every form (shtëpia, shtëpisë)
            'ia' R1 'ine' R1 'ise' R1 'ish' R1 'ite' R1
            // aorist and participle of vowel + j verbs (mbajti, luajtur, mbrojti, vërejtur)
            'jta' NotAfterE 'jte' NotAfterE 'jti' NotAfterE 'jtem' AfterV 'jtet' AfterV
            'jtur' AfterV 'ojta' R1 'ojte' R1 'ojti' R1 'ejtem' R1 'ejtet' R1 'ejtur' R1
            'ojtem' R1 'ojtet' R1 'ojtur' R1 'uajta' R1 'uajte' R1 'uajti' R1
            'uajtem' R1 'uajtet' R1 'uajtur' R1
            // plurals of -ull nouns (artikujt)
            'jt' AfterU
                (delete)
        )
    )

    // The longest ending of step2 in R1, if any, is removed.
    define step2 as (
        setlimit tomark p1 for ([substring]) among (
            // nouns, feminine: definite and oblique (molla, mollën, mollës; lulja; shtëpisë)
            'a'
            // plural and stem vowels (male, mollë; ullinj)
            'e' 'enj' 'inj'
                (delete)
        )
    )

    // The longest ending of step3 in R1, if any, is removed.
    define step3 as (
        setlimit tomark p1 for ([substring]) among (
            // derivation: nouns of action from verbs (përdorim, kultivimi → përdor, kultiv)
            'im' InR2
                (delete)
        )
    )

    // The stem's end, by the longest alternation that leaves it long enough.
    define stem_end as (
        [substring] among (
            'k' S2 (<- 'q')
            'j' R1 (delete)
            'e' R1 (delete)
            'er' S2 (<- 'r')
            'ull' S2 (<- 'u')
            'shm' NotAfterAEOUY (<- 'sh')
            'odh' (<- 'edh')
            'ytet' S1 (<- 'yt')
            'itet' S1 (<- 'it')
            'izem' (<- 'izm')
        )
    )
)

define stem as (
    do prelude
    exception or (
        do mark_regions
        backwards (
            do step1
            do step2
            do step3
            do stem_end
        )
    )
)
