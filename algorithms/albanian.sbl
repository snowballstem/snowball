// Albanian stemmer.
//
// A light, inflectional stemmer for keyword search, written for Snowball by
// edisnord (https://github.com/edisnord/albanian-stemmer), where the
// endings were pruned against Albanian corpus lexicons and the result was
// checked on retrieval benchmarks and a hand-labelled sample. That repository
// generates this file from its rules (albanian.json) and documents the
// choices made; the comments below say why each part is there.
//
// Like Romanian, Albanian suffixes its definite article and fuses it with the
// case ending (mollë, molla, mollës, mollën, mollët, mollëve), so, as in the
// Romanian stemmer, the article and case endings go first (step1, which also
// holds the verb endings: punoj, punonte, punohet, punuar), then plural and
// stem vowels (step2), then the stem's end is normalized (stem_end: sëmundj →
// sëmund, libër → libr). Derived words mostly keep their own stems (punëtor),
// except that an -oj verb meets the noun it is made from (kontrolloj,
// kontroll), and a third step joins nouns of action in -im to their verb
// (përdorimi, përdor). Stems can be shorter than any word (moll, semund).
// Some endings also need certain letters before them (as in the Finnish and
// Turkish stemmers), where a word's own letters look like the ending: -t only
// after a vowel (mollët, but rast keeps its t), -nte not after e (punonte, but
// dokumente), -së not after je (shtëpisë, but pjesë). An exception table,
// looked up first, joins the forms of the irregular verbs (vij, erdhi, ardhur;
// jam, është, qenë) and of the nouns with an irregular plural (dorë, duar;
// grua, gra).
//
// ë and ç are folded first, so text typed without them, as much Albanian
// text on the web is, stems the same.

routines ( prelude exception mark_regions R1 S1 S2 InR2 AfterV AfterKGH
    AfterE NotAfterI NotAfterIO NotAfterE NotAfterOTI NotAfterS AfterU
    NotAfterIZBLST AfterVNotJE AfterOANotIO NotAfterAEOUY step1 step2 step3
    stem_end )

externals ( stem )

integers ( p1 s1 s2 pr2 )

groupings ( v kgh )

stringescapes {}

stringdef e"   '{U+00EB}'  // e diaeresis
stringdef c,   '{U+00E7}'  // c cedilla

// Fold the two Albanian diacritics, so that a word typed without them
// (semundjes, molles) stems like its standard spelling.
define prelude as (
    do repeat goto (
        [substring] among ( '{e"}' (<- 'e') '{c,}' (<- 'c') )
    )
)

// Irregular words: their forms share no stem a suffix rule reaches
// (vij, erdhi, ardhur; them, thotë, thënë; dorë, duar), each mapped
// to one stem.
define exception as (
    [substring] atlimit among (
        'befsh' 'befsha' 'befshi' 'befshim' 'befshin' 'behej' 'behem' 'behemi'
        'behen' 'beheni' 'behesh' 'behesha' 'beheshe' 'beheshim' 'beheshin'
        'beheshit' 'behet' 'behu' 'behuni' 'bejini' 'bejme' 'beka' 'bekam'
        'bekan' 'beke' 'bekej' 'bekemi' 'bekeni' 'bekesha' 'bekeshe' 'bekeshim'
        'bekeshin' 'bekeshit' 'ben' 'bene' 'beni' 'benim' 'benin' 'benit'
        'bente' 'bera' 'bere' 'beri' 'besh' 'bete'
            (<- 'bej')
        'biem' 'biesh' 'bini' 'binim' 'binin' 'binit' 'binte' 'bjer' 'bjere'
        'bjeri' 'rane' 'rashe' 'rate' 'renc' 'renca' 'renci' 'rencim' 'rencin'
        'rene' 'renka' 'renkam' 'renkan' 'renke' 'renkej' 'renkemi' 'renkeni'
        'renkesha' 'renkeshe' 'renkeshim' 'renkeshin' 'renkeshit' 'rente'
            (<- 'bie')
        'blofsha' 'blofshi' 'blofte' 'blova' 'blove' 'bluaj' 'bluaja' 'bluaje'
        'bluajme' 'bluajne' 'bluaka' 'bluakam' 'bluakan' 'bluake' 'bluakej'
        'bluakemi' 'bluakeni' 'bluakesha' 'bluakeshe' 'bluakeshim' 'bluakeshin'
        'bluakeshit' 'bluam' 'bluan' 'bluani' 'bluanim' 'bluanin' 'bluanit'
        'bluante' 'bluar' 'bluash' 'bluat'
            (<- 'blo')
        'bredhe' 'bredhesh' 'bredhkam' 'bredhkan' 'bredhkemi'
        'bredhkeni' 'bredhsh' 'bredhsha' 'bredhshi' 'bredhshim' 'bredhshin'
        'bredhur' 'bridh' 'bridhja' 'bridhje' 'bridhni' 'bridhnim' 'bridhnin'
        'bridhnit' 'bridhte' 'brodha' 'brodhe' 'brodhem' 'brodhen' 'brodhet'
        'brodhi'
            (<- 'bredhq')
        'brigje' 'brigjet' 'brigjeve'
            (<- 'breg')
        'dyer' 'dyert' 'dyerve'
            (<- 'der')
        'djem' 'djemte' 'djemve'
            (<- 'djal')
        'digj' 'digjej' 'digjem' 'digjemi' 'digjen' 'digjeni' 'digjesh'
        'digjesha' 'digjeshe' 'digjeshim' 'digjeshin' 'digjeshit' 'digjet'
        'digjja' 'digjje' 'digjni' 'digjnim' 'digjnin' 'digjnit' 'digjte' 'djeg'
        'djege' 'djegesh' 'djegin' 'djegka' 'djegkam' 'djegkan' 'djegke'
        'djegkej' 'djegkemi' 'djegkeni' 'djegkesha' 'djegkeshe' 'djegkeshim'
        'djegkeshin' 'djegkeshit' 'djegsh' 'djegsha' 'djegshi' 'djegshim'
        'djegshin' 'djegte' 'djegur' 'dogj' 'dogja' 'dogje' 'dogjem' 'dogjen'
        'dogjet' 'dogji'
            (<- 'djegim')
        'dal' 'dale' 'dalesh' 'dalim' 'dalin' 'dalka' 'dalkam' 'dalkan' 'dalke'
        'dalkej' 'dalkemi' 'dalkeni' 'dalkesha' 'dalkeshe' 'dalkeshim'
        'dalkeshin' 'dalkeshit' 'dalsh' 'dalsha' 'dalshi' 'dalshim' 'dalshin'
        'del' 'dil' 'dilet' 'dilja' 'dilje' 'dilni' 'dilnim' 'dilnin' 'dilnit'
        'dilte' 'dual'
            (<- 'dol')
        'duar' 'duart' 'duarve'
            (<- 'dor')
        'dredh' 'dredhe' 'dredhesh' 'dredhin' 'dredhkam' 'dredhkan' 'dredhkemi'
        'dredhkeni' 'dredhsh' 'dredhsha' 'dredhshi' 'dredhshim' 'dredhshin'
        'dredhte' 'dredhur' 'drodh' 'drodha' 'drodhe' 'drodhem' 'drodhen'
        'drodhet' 'drodhi'
            (<- 'dredhq')
        'dacim' 'dacin' 'dacte' 'dashka' 'dashkam' 'dashkan' 'dashke' 'dashkej'
        'dashkemi' 'dashkeni' 'dashkesha' 'dashkeshe' 'dashkeshim' 'dashkeshin'
