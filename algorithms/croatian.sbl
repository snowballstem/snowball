        ( ['u'] test aK_73 )
        or ( ['o'] test aK_73 )
        or ( ['i'] test aK_73 )
        or ( ['e'] test aK_73 )
        or ( ['a'] test aK_73 )
        or ( ['om'] test aK_73 )
        or ( ['og'] test aK_73 )
        or ( ['im'] test aK_73 )
        or ( ['ih'] test aK_73 )
        or ( ['em'] test aK_73 )
        or ( ['oj'] test aK_73 )
        or ( ['an'] test aK_73 )
)
        R1
        delete
    )

    define aStrip as (
        aL_1
        or aL_2
        or aL_3
        or aL_4
        or aL_5
        or aL_6
        or aL_7
        or aL_8
        or aL_9
