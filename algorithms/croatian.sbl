externals ( stem )

booleans ( no_diacritics )

integers ( p1 )

groupings ( vr sa g_neg1 g_neg2 g_neg3 g_neg4 ag_neg1 ag_neg2 ag_neg3 ag_neg4 )

stringescapes {}

stringdef cv   '{U+010D}'   // č
stringdef c'   '{U+0107}'   // ć
stringdef zv   '{U+017E}'   // ž
stringdef sv   '{U+0161}'   // š
stringdef d/   '{U+0111}'   // đ

/* vowels, plus r (syllabic r): the first of these ends the shortest valid stem */
define vr 'aeiour'
/* letters that mark a word as carrying diacritics */
define sa '{cv}{c'}{zv}{sv}{d/}'
define g_neg1 'eo'
define g_neg2 'z'
define g_neg3 'dkml'
define g_neg4 'o'
define ag_neg1 'eo'
define ag_neg2 'z'
define ag_neg3 'dkml'
define ag_neg4 'o'

define mark_diacritics as (
    set no_diacritics
    do ( gopast sa unset no_diacritics )
)

define mark_regions as (
    $p1 = limit + 1
    do ( gopast vr setmark p1 )
    do ( ($p1 < 2) $p1 = 2 )
)

define stopword as (
    among (
            'bi'
            'bih'
            'bijah'
            'bijahu'
            'bijasmo'
            'bijaste'
            'bija{sv}e'
            'bila'
            'bile'
            'bili'
            'bilo'
            'bio'
            'bismo'
            'biste'
            'biti'
            'bi{sv}e'
            'bje'
            'bjeh'
            'bjehu'
            'bjesmo'
            'bjeste'
            'bje{sv}e'
            'budem'
            'budemo'
            'budete'
            'bude{sv}'
            'budimo'
            'budite'
            'budu'
            'jesam'
            'jesi'
            'jesmo'
            'jeste'
            'jesu'
            'mogu'
            'mora'
            'moraju'
            'moram'
            'moramo'
            'morate'
            'mora{sv}'
            'mo{zv}e'
            'mo{zv}emo'
            'mo{zv}ete'
            'mo{zv}e{sv}'
            'sam'
            'si'
            'smo'
            'ste'
            'su'
            'treba'
            'trebaju'
            'trebam'
            'trebamo'
            'trebate'
            'treba{sv}'
            '{c'}e'
            '{c'}emo'
            '{c'}ete'
            '{c'}e{sv}'
            '{c'}u'
            '{zv}ele'
            '{zv}eli'
            '{zv}elim'
            '{zv}elimo'
            '{zv}elite'
            '{zv}eli{sv}'
    )
    atlimit
)

define astopword as (
    among (
            'bi'
            'bih'
            'bijah'
            'bijahu'
            'bijase'
            'bijasmo'
            'bijaste'
            'bila'
            'bile'
            'bili'
            'bilo'
            'bio'
            'bise'
            'bismo'
            'biste'
            'biti'
            'bje'
            'bjeh'
            'bjehu'
            'bjese'
            'bjesmo'
            'bjeste'
            'budem'
            'budemo'
            'budes'
            'budete'
            'budimo'
            'budite'
            'budu'
            'ce'
            'cemo'
            'ces'
            'cete'
            'cu'
            'jesam'
            'jesi'
            'jesmo'
            'jeste'
            'jesu'
            'mogu'
            'mora'
            'moraju'
            'moram'
            'moramo'
            'moras'
            'morate'
            'moze'
            'mozemo'
            'mozes'
            'mozete'
            'sam'
            'si'
            'smo'
            'ste'
            'su'
            'treba'
            'trebaju'
            'trebam'
            'trebamo'
            'trebas'
            'trebate'
            'zele'
            'zeli'
            'zelim'
            'zelimo'
            'zelis'
            'zelite'
    )
    atlimit
)

backwardmode (

    define R1 as $p1 <= cursor

    /* diacritic rule set: first matching lexical transformation, in file order */
    define Transform as (
        ( ['lozi'] <- 'loga' )
        or ( ['lozima'] <- 'loga' )
        or ( ['pjesi'] <- 'pjeh' )
        or ( ['pjesima'] <- 'pjeh' )
        or ( ['vojci'] <- 'vojka' )
        or ( ['bojci'] <- 'bojka' )
        or ( ['jaci'] <- 'jak' )
        or ( ['jacima'] <- 'jak' )
        or ( ['{cv}ajan'] <- '{cv}ajni' )
        or ( ['ijeran'] <- 'ijerni' )
        or ( ['laran'] <- 'larni' )
        or ( ['ijesan'] <- 'ijesni' )
        or ( ['anjac'] <- 'anjca' )
        or ( ['ajac'] <- 'ajca' )
        or ( ['ajaca'] <- 'ajca' )
        or ( ['ljaca'] <- 'ljca' )
        or ( ['ljac'] <- 'ljca' )
        or ( ['ejac'] <- 'ejca' )
        or ( ['ejaca'] <- 'ejca' )
        or ( ['ojac'] <- 'ojca' )
        or ( ['ojaca'] <- 'ojca' )
        or ( ['ajaka'] <- 'ajka' )
        or ( ['ojaka'] <- 'ojka' )
        or ( ['{sv}aca'] <- '{sv}ca' )
        or ( ['{sv}ac'] <- '{sv}ca' )
        or ( ['inzima'] <- 'ing' )
        or ( ['inzi'] <- 'ing' )
        or ( ['tvenici'] <- 'tvenik' )
        or ( ['tetici'] <- 'tetika' )
        or ( ['teticima'] <- 'tetika' )
        or ( ['nstava'] <- 'nstva' )
        or ( ['nicima'] <- 'nik' )
        or ( ['ticima'] <- 'tik' )
        or ( ['zicima'] <- 'zik' )
        or ( ['snici'] <- 'snik' )
        or ( ['kuse'] <- 'kusi' )
        or ( ['kusan'] <- 'kusni' )
        or ( ['kustava'] <- 'kustva' )
        or ( ['du{sv}an'] <- 'du{sv}ni' )
        or ( ['antan'] <- 'antni' )
        or ( ['bilan'] <- 'bilni' )
        or ( ['tilan'] <- 'tilni' )
        or ( ['avilan'] <- 'avilni' )
        or ( ['silan'] <- 'silni' )
        or ( ['gilan'] <- 'gilni' )
        or ( ['rilan'] <- 'rilni' )
        or ( ['nilan'] <- 'nilni' )
        or ( ['alan'] <- 'alni' )
        or ( ['ozan'] <- 'ozni' )
        or ( ['rave'] <- 'ravi' )
        or ( ['stavan'] <- 'stavni' )
        or ( ['pravan'] <- 'pravni' )
        or ( ['tivan'] <- 'tivni' )
        or ( ['sivan'] <- 'sivni' )
        or ( ['atan'] <- 'atni' )
        or ( ['cenata'] <- 'centa' )
        or ( ['denata'] <- 'denta' )
        or ( ['genata'] <- 'genta' )
        or ( ['lenata'] <- 'lenta' )
        or ( ['menata'] <- 'menta' )
        or ( ['jenata'] <- 'jenta' )
        or ( ['venata'] <- 'venta' )
        or ( ['tetan'] <- 'tetni' )
        or ( ['pletan'] <- 'pletni' )
        or ( ['{sv}ave'] <- '{sv}avi' )
        or ( ['manata'] <- 'manta' )
        or ( ['tanata'] <- 'tanta' )
        or ( ['lanata'] <- 'lanta' )
        or ( ['sanata'] <- 'santa' )
        or ( ['a{cv}ak'] <- 'a{cv}ka' )
        or ( ['a{cv}aka'] <- 'a{cv}ka' )
        or ( ['u{sv}ak'] <- 'u{sv}ka' )
        or ( ['atak'] <- 'atka' )
        or ( ['ataka'] <- 'atka' )
        or ( ['atci'] <- 'atka' )
        or ( ['atcima'] <- 'atka' )
        or ( ['etak'] <- 'etka' )
        or ( ['etaka'] <- 'etka' )
        or ( ['itak'] <- 'itka' )
        or ( ['itaka'] <- 'itka' )
        or ( ['itci'] <- 'itka' )
        or ( ['otak'] <- 'otka' )
        or ( ['otaka'] <- 'otka' )
        or ( ['utak'] <- 'utka' )
        or ( ['utaka'] <- 'utka' )
        or ( ['utci'] <- 'utka' )
        or ( ['utcima'] <- 'utka' )
        or ( ['eskan'] <- 'eskna' )
        or ( ['ti{cv}an'] <- 'ti{cv}ni' )
        or ( ['ojsci'] <- 'ojska' )
        or ( ['esama'] <- 'esma' )
        or ( ['metara'] <- 'metra' )
        or ( ['centar'] <- 'centra' )
        or ( ['centara'] <- 'centra' )
        or ( ['istara'] <- 'istra' )
        or ( ['istar'] <- 'istra' )
        or ( ['o{sv}{c'}u'] <- 'osti' )
        or ( ['daba'] <- 'dba' )
        or ( ['{cv}cima'] <- '{cv}ka' )
        or ( ['{cv}ci'] <- '{cv}ka' )
        or ( ['mac'] <- 'mca' )
        or ( ['maca'] <- 'mca' )
        or ( ['naca'] <- 'nca' )
        or ( ['nac'] <- 'nca' )
        or ( ['voljan'] <- 'voljni' )
        or ( ['anaka'] <- 'anki' )
        or ( ['vac'] <- 'vca' )
        or ( ['vaca'] <- 'vca' )
        or ( ['saca'] <- 'sca' )
        or ( ['sac'] <- 'sca' )
        or ( ['raca'] <- 'rca' )
        or ( ['rac'] <- 'rca' )
        or ( ['aoca'] <- 'alca' )
        or ( ['alaca'] <- 'alca' )
        or ( ['alac'] <- 'alca' )
        or ( ['elaca'] <- 'elca' )
        or ( ['elac'] <- 'elca' )
        or ( ['olaca'] <- 'olca' )
        or ( ['olac'] <- 'olca' )
        or ( ['olce'] <- 'olca' )
        or ( ['njac'] <- 'njca' )
        or ( ['njaca'] <- 'njca' )
        or ( ['ekata'] <- 'ekta' )
        or ( ['ekat'] <- 'ekta' )
        or ( ['izam'] <- 'izma' )
        or ( ['izama'] <- 'izma' )
        or ( ['jebe'] <- 'jebi' )
        or ( ['baci'] <- 'baci' )
        or ( ['a{sv}an'] <- 'a{sv}ni' )
    )

    define K_1 as ( 'k' ( ( 's' next ) or ( '{sv}' next ) ) )
    define K_2 as ( 'tv' ( ( 's' next ) or ( '{sv}' next ) ) )
    define K_3 as ( 'anij' ( ( 't' next ) or ( 'm' next ) or ( 'p' next ) or ( 'r' next ) or ( 'g' next ) ) )
    define K_4 as ( 'an' next )
    define K_5 as ( 'in' next )
    define K_6 as ( 'on' next )
    define K_7 as ( 'n' next )
    define K_8 as ( '{c'}' ( ( 'a' next ) or ( 'e' next ) or ( 'u' next ) ) )
    define K_9 as ( 'ugov' next )
    define K_10 as ( 'ug' next )
    define K_11 as ( 'log' next )
    define K_12 as ( 'g' non-g_neg1 next )
    define K_13 as ( 'i' ( ( 'rrar' next ) or ( 'ott' next ) or ( 'ss' next ) or ( 'll' next ) ) )
    define K_14 as ( 'uj' next )
    define K_15 as ( 'aj' ( ( 'c' next ) or ( '{cv}' next ) or ( '{c'}' next ) or ( '{d/}' next ) or ( 'l' next ) or ( 'r' next ) ) )
    define K_16 as ( 'ij' ( ( 'b' next ) or ( 'c' next ) or ( 'd' next ) or ( 'l' next ) or ( 'n' next ) or ( 'm' next ) or ( '{zv}' next ) or ( 'g' next ) or ( 'f' next ) or ( 'p' next ) or ( 'r' next ) or ( 's' next ) or ( 't' next ) or ( 'z' next ) ) )
    define K_17 as ( 'nal' non-g_neg2 next )
    define K_18 as ( 'ijal' next )
    define K_19 as ( 'ozil' next )
    define K_20 as ( 'olov' next )
    define K_21 as ( 'ol' next )
    define K_22 as ( 'lem' next )
    define K_23 as ( 'ram' next )
    define K_24 as ( 'r' ( ( 'a' next ) or ( 'd' next ) or ( 'e' next ) or ( 'o' next ) ) )
    define K_25 as ( 's' ( ( 'e' next ) or ( 'i' next ) ) )
    define K_26 as ( 'a{sv}' ( ( 't' next ) or ( 'n' next ) or ( 'j' next ) or ( 'k' next ) or ( 'b' next ) or ( 'g' next ) or ( 'v' next ) ) )
    define K_27 as ( '{sv}' ( ( 'e' next ) or ( 'i' next ) ) )
    define K_28 as ( 'ikat' next )
    define K_29 as ( 'lat' next )
    define K_30 as ( 'et' next )
    define K_31 as ( 'st' ( ( 'e' next ) or ( 'i' next ) or ( 'k' next ) or ( 'o' next ) ) )
    define K_32 as ( 'i{sv}t' next )
    define K_33 as ( 'ova' next )
    define K_34 as ( 'v' ( ( 'a' next ) or ( 'e' next ) or ( 'i' next ) ) )
    define K_35 as ( 'ov' non-g_neg3 next )
    define K_36 as ( 'ov' ( ( 'm' next ) or ( 'l' next ) ) )
    define K_37 as ( 'el' next )
    define K_38 as ( 'nj' ( ( 'a' next ) or ( 'e' next ) or ( '{sv}' next ) ) )
    define K_39 as ( '{cv}in' next )
    define K_40 as ( 'ro{sv}i' next )
    define K_41 as ( 'o{sv}' next )
    define K_42 as ( 'vit' ( ( 'e' next ) or ( 'o' next ) ) )
    define K_43 as ( 'ast' next )
    define K_44 as ( 'k' next )
    define K_45 as ( 'va' ( ( 'e' next ) or ( 'a' next ) or ( 'i' next ) or ( 'u' next ) ) )
    define K_46 as ( 'ir' next )
    define K_47 as ( 'a{cv}' next )
    define K_48 as ( 'a{cv}a' next )
    define K_49 as ( 'n' next )
    define K_50 as ( 'ni' next )
    define K_51 as ( 'a' ( ( 'st' ( ( 'a' next ) or ( 'r' next ) or ( 'i' next ) or ( 'p' next ) or ( 'e' next ) or ( 'u' next ) ) ) or ( 'g' non-g_neg4 next ) or ( 'ik' next ) or ( 'uc' next ) or ( 'oj' next ) or ( 'aj' next ) or ( 'lj' next ) or ( 'ak' next ) or ( 'ck' next ) or ( '{cv}k' next ) or ( '{sv}k' next ) or ( 'uk' next ) or ( 'nj' next ) or ( 'im' next ) or ( 'ar' next ) or ( 'at' next ) or ( 'et' next ) or ( '{sv}t' next ) or ( 'it' next ) or ( 'ot' next ) or ( 'ut' next ) or ( 'zn' next ) or ( 'zv' next ) ) )
    define K_52 as ( 'ur' next )
    define K_53 as ( 'staj' ( ( 'a' next ) or ( 'i' next ) or ( 'o' next ) ) )
    define K_54 as ( 'a' ( ( 'b' next ) or ( 'c' next ) or ( '{cv}' next ) or ( '{c'}' next ) or ( 'd' next ) or ( 'e' next ) or ( 'f' next ) or ( 'g' next ) or ( 'j' next ) or ( 'k' next ) or ( 'n' next ) or ( 'r' next ) or ( 't' next ) or ( 'u' next ) or ( 'v' next ) ) )
    define K_55 as ( 'aj' ( ( 't' next ) or ( '{cv}' next ) or ( 'j' next ) or ( '{zv}' next ) or ( '{sv}' next ) ) )
    define K_56 as ( 'a' ( ( 'm' non-g_neg4 next ) or ( 'i{cv}' next ) or ( 'n{cv}' next ) or ( 'u{cv}' next ) or ( 'b' next ) or ( 'c' next ) or ( '{c'}' next ) or ( 'd' next ) or ( '{d/}' next ) or ( 'h' next ) or ( 'j' next ) or ( 'k' next ) or ( 'l' next ) or ( 'n' next ) or ( 'p' next ) or ( 'r' next ) or ( 's' next ) or ( '{sv}' next ) or ( 'v' next ) or ( 'z' next ) or ( '{zv}' next ) ) )
    define K_57 as ( 'sta' ( ( 'a' next ) or ( 'i' next ) or ( 'o' next ) ) )
    define K_58 as ( 'ta' next )
    define K_59 as ( 'inj' next )
    define K_60 as ( 'as' next )
    define K_61 as ( 'i' ( ( 'elj' next ) or ( 'ulj' next ) or ( 'tit' next ) or ( 'ac' next ) or ( 'i{cv}' next ) or ( 'od' next ) or ( 'oj' next ) or ( 'et' next ) or ( 'av' next ) or ( 'ov' next ) ) )
    define K_62 as ( 'i' ( ( 'tit' next ) or ( 'jeb' next ) or ( 'ar' next ) or ( 'ed' next ) or ( 'u{sv}' next ) or ( 'i{cv}' next ) ) )
    define K_63 as ( 'i' ( ( 'b' next ) or ( '{cv}' next ) or ( 'd' next ) or ( 'l' next ) or ( 'm' next ) or ( 'p' next ) or ( 'r' next ) or ( 's' next ) or ( '{sv}' next ) or ( '{zv}' next ) ) )
    define K_64 as ( 'lu{cv}' next )
    define K_65 as ( 'jeti' next )
    define K_66 as ( 'e' next )
    define K_67 as ( 'i' next )
    define K_68 as ( 'at' next )
    define K_69 as ( 'et' next )
    define K_70 as ( next )
    define K_71 as ( next )
    define K_72 as ( next )
    define K_73 as ( next )

    define L_1 as (
(
        ( ['i'] test K_1 )
        or ( ['e'] test K_1 )
        or ( ['o'] test K_1 )
        or ( ['a'] test K_1 )
        or ( ['u'] test K_1 )
        or ( ['og'] test K_1 )
