            'jmo' K_56 'jte' K_56 'smo' K_56 'ste' K_56 'vsi' aK_56 'hu' K_56
            'ju' K_56 'la' K_56 'le' K_56 'li' K_56 'lo' K_56 'mo' K_56 'na' K_56
            'ne' K_56 'ni' K_56 'no' K_56 'se' aK_56 'te' K_56 'ti' K_56 'h' K_56
            'j' K_56 'm' K_56 'n' K_56 'o' K_56 's' aK_56 't' K_56
          ) delete )
        or
        // .+(a|i|o)sta dosmo|doste|doše|nemo|demo|nete|dete|nimo|nite|nila|vši|nem|dem|neš|deš|doh|de|ti|ne|nu|du|la|li|lo|le|t|o
        ( [substring] among (
            'do{sv}e' K_57 'de{sv}' K_57 'ne{sv}' K_57 'v{sv}i' K_57 'dosmo' K_57
            'doste' K_57 'demo' K_57 'dete' K_57 'dose' aK_57 'nemo' K_57
            'nete' K_57 'nila' K_57 'nimo' K_57 'nite' K_57 'dem' K_57 'des' aK_57
            'doh' K_57 'nem' K_57 'nes' aK_57 'vsi' aK_57 'de' K_57 'du' K_57
            'la' K_57 'le' K_57 'li' K_57 'lo' K_57 'ne' K_57 'nu' K_57 'ti' K_57
            'o' K_57 't' K_57
          ) delete )
        or
        // .+ta smo|ste|jmo|jte|vši|ti|mo|te|ju|še|la|lo|le|li|na|no|ni|ne|n|j|o|m|š|t|h
        ( [substring] among (
            'v{sv}i' K_58 '{sv}e' K_58 '{sv}' K_58 'jmo' K_58 'jte' K_58 'smo' K_58
            'ste' K_58 'vsi' aK_58 'ju' K_58 'la' K_58 'le' K_58 'li' K_58 'lo' K_58
            'mo' K_58 'na' K_58 'ne' K_58 'ni' K_58 'no' K_58 'se' aK_58 'te' K_58
            'ti' K_58 'h' K_58 'j' K_58 'm' K_58 'n' K_58 'o' K_58 's' aK_58
            't' K_58
          ) delete )
        or
        // .+inj asmo|aste|ati|emo|ete|ali|ala|alo|ale|aše|ahu|em|eš|at|ah|ao
        ( [substring] among (
            'a{sv}e' K_59 'e{sv}' K_59 'asmo' K_59 'aste' K_59 'ahu' K_59 'ala' K_59
            'ale' K_59 'ali' K_59 'alo' K_59 'ase' aK_59 'ati' K_59 'emo' K_59
            'ete' K_59 'ah' K_59 'ao' K_59 'at' K_59 'em' K_59 'es' aK_59
          ) delete )
        or
        // .+as temo|tete|timo|tite|tući|tem|teš|tao|te|li|ti|la|lo|le
        ( [substring] among (
            'tu{c'}i' K_60 'te{sv}' K_60 'temo' K_60 'tete' K_60 'timo' K_60
            'tite' K_60 'tuci' aK_60 'tao' K_60 'tem' K_60 'tes' aK_60 'la' K_60
            'le' K_60 'li' K_60 'lo' K_60 'te' K_60 'ti' K_60
          ) delete )
        or
        // .+(elj|ulj|tit|ac|ič|od|oj|et|av|ov)i vši|eći|smo|ste|še|mo|te|ti|li|la|lo|le|m|š|t|h|o
        ( [substring] among (
            'e{c'}i' K_61 'v{sv}i' K_61 '{sv}e' K_61 '{sv}' K_61 'eci' aK_61
            'smo' K_61 'ste' K_61 'vsi' aK_61 'la' K_61 'le' K_61 'li' K_61
            'lo' K_61 'mo' K_61 'se' aK_61 'te' K_61 'ti' K_61 'h' K_61 'm' K_61
            'o' K_61 's' aK_61 't' K_61
          ) delete )
        or
        // .+(tit|jeb|ar|ed|uš|ič)i jemo|jete|jem|ješ|smo|ste|jmo|jte|vši|mo|še|te|ti|ju|je|la|lo|li|le|t|m|š|h|j|o
        ( [substring] among (
            'je{sv}' K_62 'v{sv}i' K_62 '{sv}e' K_62 'jemo' K_62 'jete' K_62
            '{sv}' K_62 'jem' K_62 'jes' aK_62 'jmo' K_62 'jte' K_62 'smo' K_62
            'ste' K_62 'vsi' aK_62 'je' K_62 'ju' K_62 'la' K_62 'le' K_62 'li' K_62
            'lo' K_62 'mo' K_62 'se' aK_62 'te' K_62 'ti' K_62 'h' K_62 'j' K_62
            'm' K_62 'o' K_62 's' aK_62 't' K_62
          ) delete )
        or
        // .+(b|č|d|l|m|p|r|s|š|ž)i jemo|jete|jem|ješ|smo|ste|jmo|jte|vši|mo|lu|še|te|ti|ju|je|la|lo|li|le|t|m|š|h|j|o
        ( [substring] among (
            'je{sv}' K_63 'v{sv}i' K_63 '{sv}e' K_63 'jemo' K_63 'jete' K_63
            '{sv}' K_63 'jem' K_63 'jes' aK_63 'jmo' K_63 'jte' K_63 'smo' K_63
            'ste' K_63 'vsi' aK_63 'je' K_63 'ju' K_63 'la' K_63 'le' K_63 'li' K_63
            'lo' K_63 'lu' K_63 'mo' K_63 'se' aK_63 'te' K_63 'ti' K_63 'h' K_63
            'j' K_63 'm' K_63 'o' K_63 's' aK_63 't' K_63
          ) delete )
        or
        // .+luč ujete|ujući|ujemo|ujem|uješ|ismo|iste|ujmo|ujte|uje|uju|iše|iti|imo|ite|ila|ilo|ili|ile|ena|eno|eni|ene|uj|io|en|im|iš|it|ih|e|i
        ( [substring] among (
            'uju{c'}i' K_64 'uje{sv}' K_64 'i{sv}e' K_64 'i{sv}' K_64 'ujemo' K_64
            'ujete' K_64 'ujuci' aK_64 'ismo' K_64 'iste' K_64 'ujem' K_64
            'ujes' aK_64 'ujmo' K_64 'ujte' K_64 'ena' K_64 'ene' K_64 'eni' K_64
            'eno' K_64 'ila' K_64 'ile' K_64 'ili' K_64 'ilo' K_64 'imo' K_64
            'ise' aK_64 'ite' K_64 'iti' K_64 'uje' K_64 'uju' K_64 'en' K_64
            'ih' K_64 'im' K_64 'io' K_64 'is' aK_64 'it' K_64 'uj' K_64 'e' K_64
            'i' K_64
          ) delete )
        or
        // .+jeti smo|ste|še|mo|te|ti|li|la|lo|le|m|š|t|h|o
        ( [substring] among (
            '{sv}e' K_65 '{sv}' K_65 'smo' K_65 'ste' K_65 'la' K_65 'le' K_65
            'li' K_65 'lo' K_65 'mo' K_65 'se' aK_65 'te' K_65 'ti' K_65 'h' K_65
            'm' K_65 'o' K_65 's' aK_65 't' K_65
          ) delete )
        or
        // .+e lama|lima|lom|lu|li|la|le|lo|l
        ( [substring] among (
            'lama' K_66 'lima' K_66 'lom' K_66 'la' K_66 'le' K_66 'li' K_66
            'lo' K_66 'lu' K_66 'l' K_66
          ) delete )
        or
        // .+i lama|lima|lom|lu|li|la|le|lo|l
        ( [substring] among (
            'lama' K_67 'lima' K_67 'lom' K_67 'la' K_67 'le' K_67 'li' K_67
            'lo' K_67 'lu' K_67 'l' K_67
          ) delete )
        or
        // .+at ijega|ijemu|ijima|ijeg|ijem|ijih|ijim|ima|oga|ome|omu|iji|ije|ija|iju|oj|og|om|im|ih|a|u|i|e|o|
        ( [substring] among (
            'ijega' K_68 'ijemu' K_68 'ijima' K_68 'ijeg' K_68 'ijem' K_68
            'ijih' K_68 'ijim' K_68 'ija' K_68 'ije' K_68 'iji' K_68 'iju' K_68
            'ima' K_68 'oga' K_68 'ome' K_68 'omu' K_68 'ih' K_68 'im' K_68
            'og' K_68 'oj' K_68 'om' K_68 'a' K_68 'e' K_68 'i' K_68 'o' K_68
            'u' K_68
          ) delete )
        or K_68
        or
        // .+et avši|ući|emo|imo|em|eš|e|u|i
        ( [substring] among (
            'av{sv}i' K_69 'u{c'}i' K_69 'e{sv}' K_69 'avsi' aK_69 'emo' K_69
            'imo' K_69 'uci' aK_69 'em' K_69 'es' aK_69 'e' K_69 'i' K_69 'u' K_69
          ) delete )
        or
        // .+ ajući|alima|alom|avši|asmo|aste|ajmo|ajte|ivši|amo|ate|aju|ati|aše|ahu|ali|ala|ale|alo|ana|ano|ani|ane|am|aš|at|ah|ao|aj|an
        ( [substring] among (
            'aju{c'}i' R1 'av{sv}i' R1 'iv{sv}i' R1 'a{sv}e' R1 'ajuci' aR1
            'alima' R1 'a{sv}' R1 'ajmo' R1 'ajte' R1 'alom' R1 'asmo' R1 'aste' R1
            'avsi' aR1 'ivsi' aR1 'ahu' R1 'aju' R1 'ala' R1 'ale' R1 'ali' R1
            'alo' R1 'amo' R1 'ana' R1 'ane' R1 'ani' R1 'ano' R1 'ase' aR1 'ate' R1
            'ati' R1 'ah' R1 'aj' R1 'am' R1 'an' R1 'ao' R1 'as' aR1 'at' R1
          ) delete )
        or
        // .+ anje|enje|anja|enja|enom|enoj|enog|enim|enih|anom|anoj|anog|anim|anih|eno|ovi|ova|oga|ima|ove|enu|anu|ena|ama
        ( [substring] among (
            'anih' R1 'anim' R1 'anja' R1 'anje' R1 'anog' R1 'anoj' R1 'anom' R1
            'enih' R1 'enim' R1 'enja' R1 'enje' R1 'enog' R1 'enoj' R1 'enom' R1
            'ama' R1 'anu' R1 'ena' R1 'eno' R1 'enu' R1 'ima' R1 'oga' R1 'ova' R1
            'ove' R1 'ovi' R1
          ) delete )
        or
        // .+ nijega|nijemu|nijima|nijeg|nijem|nijim|nijih|nima|niji|nije|nija|niju|noj|nom|nog|nim|nih|an|na|nu|ni|ne|no
        ( [substring] among (
            'nijega' R1 'nijemu' R1 'nijima' R1 'nijeg' R1 'nijem' R1 'nijih' R1
            'nijim' R1 'nija' R1 'nije' R1 'niji' R1 'niju' R1 'nima' R1 'nih' R1
            'nim' R1 'nog' R1 'noj' R1 'nom' R1 'an' R1 'na' R1 'ne' R1 'ni' R1
            'no' R1 'nu' R1
          ) delete )
        or
        // .+ om|og|im|ih|em|oj|an|u|o|i|e|a
        ( [substring] among (
            'an' R1 'em' R1 'ih' R1 'im' R1 'og' R1 'oj' R1 'om' R1 'a' R1 'e' R1
            'i' R1 'o' R1 'u' R1
          ) delete )
    )

)

define stem as (
    do mark_diacritics
    stopword or (
        backwards ( do Transform )
        do mark_regions
        backwards ( do Strip )
    )
)
