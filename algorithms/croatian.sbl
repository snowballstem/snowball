        or aL_73
    )

)

define stem as (
    do mark_diacritics
    (
        no_diacritics
        (
            astopword
            or (
                backwards ( do aTransform )
                do mark_regions
                backwards ( do aStrip )
            )
        )
    ) or (
        stopword
        or (
            backwards ( do Transform )
            do mark_regions
            backwards ( do Strip )
        )
    )
)
