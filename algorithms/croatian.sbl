/* Croatian stemmer for Snowball.
 *
 * Based on the rule tables of the "Simple stemmer for Croatian v0.2",
 * Copyright 2012 Nikola Ljubešić and Ivan Pandžić,
 * http://nlp.ffzg.hr/resources/tools/stemmer-for-croatian/
 * (originally LGPLv3; both authors have agreed to their use in Snowball under
 * the BSD-3-Clause licence), and on the algorithm described in
 *   Nikola Ljubešić, Damir Boras, Ozren Kubelka (2007), "Retrieving Information
 *   in Croatian: Building a Simple and Efficient Rule-Based Stemmer".
 * The rules below are generated from those tables by a script: one among per
 * rule line, tried in the original order.
 *
 * Words containing a c-caron, c-acute, s-caron, z-caron or d-stroke use the rules as
 * published; all other words use the same rules with those letters folded to
 * c c s z d, so the stemmer also works behind engines that strip diacritics before
 * stemming.  Strings that exist only in the folded rules require no_diacritics
 * (aR1, aK_n, a_more, and in Transform the action).
 */

routines (
    mark_regions mark_diacritics stopword R1 aR1 Transform Strip
    more a_more not_o_more K_1 K_2 K_3 K_4 K_5 K_6 K_7 K_8 K_9 K_10 K_11
    K_12 K_13 K_14 aK_14 K_15 K_16 K_17 K_18 K_19 K_20 K_21 K_22 K_23 K_24
    K_25 K_26 K_27 K_28 K_29 K_30 K_31 K_32 K_33 aK_33 K_34 K_35 K_36 K_37
    K_38 K_39 K_40 aK_40 K_41 K_42 K_43 K_44 K_45 aK_45 K_46 aK_46 K_47
    aK_47 K_48 aK_48 K_49 aK_49 K_50 aK_50 K_51 aK_51 K_52 aK_52 K_53 aK_53
    K_54 K_55 K_56 aK_56 K_57 aK_57 K_58 aK_58 K_59 aK_59 K_60 aK_60 K_61
    aK_61 K_62 aK_62 K_63 aK_63 K_64 aK_64 K_65 aK_65 K_66 K_67 K_68 K_69
    aK_69
)

externals ( stem )

booleans ( no_diacritics )

integers ( p1 )

groupings (
    vr sa
    g_adeo g_aei g_aeiu g_aes g_aesv g_aeu g_aio g_bcdefgjknrtuvcjcv
    g_bcdfglmnprstzzv g_bcdhjklnprsvz g_bcdhjklnprsvzcjdjsvzv g_bcdlmprsz
    g_bdlmprscvsvzv g_bgjkntv g_cdlr g_cjstz g_clrcjcvdj g_dklm g_ei g_eiko
    g_eo g_gmprt g_inu g_jtcvsvzv g_lm g_o g_ssv g_z
)

stringescapes {}

stringdef cv   '{U+010D}'   // č
stringdef c'   '{U+0107}'   // ć
stringdef zv   '{U+017E}'   // ž
stringdef sv   '{U+0161}'   // š
stringdef d/   '{U+0111}'   // đ

/* vowels, plus r (syllabic r): the first of these ends the shortest valid stem */
define vr 'aeiour'
/* letters that mark a word as carrying diacritics */
define sa '{cv}{c'}{zv}{sv}{d/}'
define g_adeo 'adeo'
define g_aei 'aei'
define g_aeiu 'aeiu'
define g_aes 'aes'
define g_aesv 'ae{sv}'
define g_aeu 'aeu'
define g_aio 'aio'
define g_bcdefgjknrtuvcjcv 'bcdefgjknrtuv{c'}{cv}'
define g_bcdfglmnprstzzv 'bcdfglmnprstz{zv}'
define g_bcdhjklnprsvz 'bcdhjklnprsvz'
define g_bcdhjklnprsvzcjdjsvzv 'bcdhjklnprsvz{c'}{d/}{sv}{zv}'
define g_bcdlmprsz 'bcdlmprsz'
define g_bdlmprscvsvzv 'bdlmprs{cv}{sv}{zv}'
define g_bgjkntv 'bgjkntv'
define g_cdlr 'cdlr'
define g_cjstz 'cjstz'
define g_clrcjcvdj 'clr{c'}{cv}{d/}'
define g_dklm 'dklm'
define g_ei 'ei'
define g_eiko 'eiko'
define g_eo 'eo'
define g_gmprt 'gmprt'
define g_inu 'inu'
define g_jtcvsvzv 'jt{cv}{sv}{zv}'
define g_lm 'lm'
define g_o 'o'
define g_ssv 's{sv}'
define g_z 'z'

define mark_diacritics as (
    set no_diacritics
    do ( gopast sa unset no_diacritics )
)

define mark_regions as (
    $p1 = limit + 1
    do ( gopast vr setmark p1 )
    do ( ($p1 < 2) $p1 = 2 )
)

define stopword as (
    among (
            'bi' 'bih' 'bijah' 'bijahu' 'bijase' 'bijasmo' 'bijaste' 'bija{sv}e'
            'bila' 'bile' 'bili' 'bilo' 'bio' 'bise' 'bismo' 'biste' 'biti'
            'bi{sv}e' 'bje' 'bjeh' 'bjehu' 'bjese' 'bjesmo' 'bjeste' 'bje{sv}e'
            'budem' 'budemo' 'budes' 'budete' 'bude{sv}' 'budimo' 'budite' 'budu'
            'ce' 'cemo' 'ces' 'cete' 'cu' 'jesam' 'jesi' 'jesmo' 'jeste' 'jesu'
            'mogu' 'mora' 'moraju' 'moram' 'moramo' 'moras' 'morate' 'mora{sv}'
            'moze' 'mozemo' 'mozes' 'mozete' 'mo{zv}e' 'mo{zv}emo' 'mo{zv}ete'
            'mo{zv}e{sv}' 'sam' 'si' 'smo' 'ste' 'su' 'treba' 'trebaju' 'trebam'
            'trebamo' 'trebas' 'trebate' 'treba{sv}' 'zele' 'zeli' 'zelim' 'zelimo'
            'zelis' 'zelite' '{c'}e' '{c'}emo' '{c'}ete' '{c'}e{sv}' '{c'}u'
            '{zv}ele' '{zv}eli' '{zv}elim' '{zv}elimo' '{zv}elite' '{zv}eli{sv}'
    )
    atlimit
)

backwardmode (

    /* a valid stem contains a vowel or r and is at least two letters long */
    define R1 as $p1 <= cursor

    define aR1 as ( no_diacritics R1 )

    /* the first matching lexical transformation (the longest: no transformation ends in an
       earlier one, which the generating script checks) */
    define Transform as (
        [substring] among (
            'lozima' 'lozi'
                (<- 'loga')
            'pjesima' 'pjesi'
                (<- 'pjeh')
            'vojci'
                (<- 'vojka')
            'bojci'
                (<- 'bojka')
            'jacima' 'jaci'
                (<- 'jak')
            '{cv}ajan'
                (<- '{cv}ajni')
            'cajan'
                (no_diacritics <- 'cajni')
            'ijeran'
                (<- 'ijerni')
            'laran'
                (<- 'larni')
            'ijesan'
                (<- 'ijesni')
            'anjac'
                (<- 'anjca')
            'ajaca' 'ajac'
                (<- 'ajca')
            'ljaca' 'ljac'
                (<- 'ljca')
            'ejaca' 'ejac'
                (<- 'ejca')
            'ojaca' 'ojac'
                (<- 'ojca')
            'ajaka'
                (<- 'ajka')
            'ojaka'
                (<- 'ojka')
            'saca' 'sac'
                (<- 'sca')
            '{sv}aca' '{sv}ac'
                (<- '{sv}ca')
            'inzima' 'inzi'
                (<- 'ing')
            'tvenici'
                (<- 'tvenik')
            'teticima' 'tetici'
                (<- 'tetika')
            'nstava'
                (<- 'nstva')
            'nicima'
                (<- 'nik')
            'ticima'
                (<- 'tik')
            'zicima'
                (<- 'zik')
            'snici'
                (<- 'snik')
            'kuse'
                (<- 'kusi')
            'kusan'
                (<- 'kusni')
            'kustava'
                (<- 'kustva')
            'du{sv}an'
                (<- 'du{sv}ni')
            'dusan'
                (no_diacritics <- 'dusni')
            'antan'
                (<- 'antni')
            'bilan'
                (<- 'bilni')
            'tilan'
                (<- 'tilni')
            'avilan'
                (<- 'avilni')
            'silan'
                (<- 'silni')
            'gilan'
                (<- 'gilni')
            'rilan'
                (<- 'rilni')
            'nilan'
                (<- 'nilni')
            'alan'
                (<- 'alni')
            'ozan'
                (<- 'ozni')
            'rave'
                (<- 'ravi')
            'stavan'
                (<- 'stavni')
            'pravan'
                (<- 'pravni')
            'tivan'
                (<- 'tivni')
            'sivan'
                (<- 'sivni')
            'atan'
                (<- 'atni')
            'cenata'
                (<- 'centa')
            'denata'
                (<- 'denta')
            'genata'
                (<- 'genta')
            'lenata'
                (<- 'lenta')
            'menata'
                (<- 'menta')
            'jenata'
                (<- 'jenta')
            'venata'
                (<- 'venta')
            'tetan'
                (<- 'tetni')
            'pletan'
                (<- 'pletni')
            '{sv}ave'
                (<- '{sv}avi')
            'save'
                (no_diacritics <- 'savi')
            'manata'
                (<- 'manta')
            'tanata'
                (<- 'tanta')
            'lanata'
                (<- 'lanta')
            'sanata'
                (<- 'santa')
            'a{cv}aka' 'a{cv}ak'
                (<- 'a{cv}ka')
            'acaka' 'acak'
                (no_diacritics <- 'acka')
            'u{sv}ak'
                (<- 'u{sv}ka')
            'usak'
                (no_diacritics <- 'uska')
            'atcima' 'ataka' 'atak' 'atci'
                (<- 'atka')
            'etaka' 'etak'
                (<- 'etka')
            'itaka' 'itak' 'itci'
                (<- 'itka')
            'otaka' 'otak'
                (<- 'otka')
            'utcima' 'utaka' 'utak' 'utci'
                (<- 'utka')
            'eskan'
                (<- 'eskna')
            'ti{cv}an'
                (<- 'ti{cv}ni')
            'tican'
                (no_diacritics <- 'ticni')
            'ojsci'
                (<- 'ojska')
            'esama'
                (<- 'esma')
            'metara'
                (<- 'metra')
            'centara' 'centar'
                (<- 'centra')
            'istara' 'istar'
                (<- 'istra')
            'o{sv}{c'}u'
                (<- 'osti')
            'oscu'
                (no_diacritics <- 'osti')
            'daba'
                (<- 'dba')
            '{cv}cima' '{cv}ci'
                (<- '{cv}ka')
            'ccima' 'cci'
                (no_diacritics <- 'cka')
            'maca' 'mac'
                (<- 'mca')
            'naca' 'nac'
                (<- 'nca')
            'voljan'
                (<- 'voljni')
            'anaka'
                (<- 'anki')
            'vaca' 'vac'
                (<- 'vca')
            'raca' 'rac'
                (<- 'rca')
            'alaca' 'alac' 'aoca'
                (<- 'alca')
            'elaca' 'elac'
                (<- 'elca')
            'olaca' 'olac' 'olce'
                (<- 'olca')
            'njaca' 'njac'
                (<- 'njca')
            'ekata' 'ekat'
                (<- 'ekta')
            'izama' 'izam'
                (<- 'izma')
            'jebe'
                (<- 'jebi')
            'baci'
                (<- 'baci')
            'a{sv}an'
                (<- 'a{sv}ni')
            'asan'
                (no_diacritics <- 'asni')
        )
    )

    /* conditions in the among of a stem pattern: the rest of an alternative, then '.+' */
    define more as ( next )
    define a_more as ( no_diacritics next )
    define not_o_more as ( non-g_o next )

    /* K_n: the stem left of an ending of rule line n is valid and matches the line's pattern
       ('.+' followed by the pattern); aK_n: the same, for strings only in the folded rules */
    define K_1 as ( R1 'k' g_ssv next )
    define K_2 as ( R1 'tv' g_ssv next )
    define K_3 as ( R1 'anij' g_gmprt next )
    define K_4 as ( R1 'an' next )
    define K_5 as ( R1 'in' next )
    define K_6 as ( R1 'on' next )
    define K_7 as ( R1 'n' next )
    define K_8 as (
        R1
        ( no_diacritics 'c' g_aeu next ) or
        ( '{c'}' g_aeu next )
    )
    define K_9 as ( R1 'ugov' next )
    define K_10 as ( R1 'ug' next )
    define K_11 as ( R1 'log' next )
    define K_12 as ( R1 'g' non-g_eo next )
    define K_13 as ( R1 'i' ( ( 'rrar' next ) or ( 'ott' next ) or ( 'ss' next ) or ( 'll' next ) ) )
    define K_14 as ( R1 'uj' next )
    define aK_14 as ( no_diacritics K_14 )
    define K_15 as (
        R1
        ( no_diacritics 'aj' g_cdlr next ) or
        ( 'aj' g_clrcjcvdj next )
    )
    define K_16 as ( R1 'ij' g_bcdfglmnprstzzv next )
    define K_17 as ( R1 'nal' non-g_z next )
    define K_18 as ( R1 'ijal' next )
    define K_19 as ( R1 'ozil' next )
    define K_20 as ( R1 'olov' next )
    define K_21 as ( R1 'ol' next )
    define K_22 as ( R1 'lem' next )
    define K_23 as ( R1 'ram' next )
    define K_24 as ( R1 'r' g_adeo next )
    define K_25 as ( R1 's' g_ei next )
    define K_26 as (
        R1
        ( no_diacritics 'as' g_bgjkntv next ) or
        ( 'a{sv}' g_bgjkntv next )
    )
    define K_27 as (
        R1
        ( no_diacritics 's' g_ei next ) or
        ( '{sv}' g_ei next )
    )
    define K_28 as ( R1 'ikat' next )
    define K_29 as ( R1 'lat' next )
    define K_30 as ( R1 'et' next )
    define K_31 as ( R1 'st' g_eiko next )
    define K_32 as (
        R1
        ( no_diacritics 'ist' next ) or
        ( 'i{sv}t' next )
    )
    define K_33 as ( R1 'ova' next )
    define aK_33 as ( no_diacritics K_33 )
    define K_34 as ( R1 'v' g_aei next )
    define K_35 as ( R1 'ov' non-g_dklm next )
    define K_36 as ( R1 'ov' g_lm next )
    define K_37 as ( R1 'el' next )
    define K_38 as (
        R1
        ( no_diacritics 'nj' g_aes next ) or
        ( 'nj' g_aesv next )
    )
    define K_39 as (
        R1
        ( no_diacritics 'cin' next ) or
        ( '{cv}in' next )
    )
    define K_40 as (
        R1
        ( no_diacritics 'rosi' next ) or
        ( 'ro{sv}i' next )
    )
    define aK_40 as ( no_diacritics K_40 )
    define K_41 as (
        R1
        ( no_diacritics 'os' next ) or
        ( 'o{sv}' next )
    )
    define K_42 as ( R1 'vit' g_eo next )
    define K_43 as ( R1 'ast' next )
    define K_44 as ( R1 'k' next )
    define K_45 as ( R1 'va' g_aeiu next )
    define aK_45 as ( no_diacritics K_45 )
    define K_46 as ( R1 'ir' next )
    define aK_46 as ( no_diacritics K_46 )
    define K_47 as (
        R1
        ( no_diacritics 'ac' next ) or
        ( 'a{cv}' next )
    )
    define aK_47 as ( no_diacritics K_47 )
    define K_48 as (
        R1
        ( no_diacritics 'aca' next ) or
        ( 'a{cv}a' next )
    )
    define aK_48 as ( no_diacritics K_48 )
    define K_49 as ( R1 'n' next )
    define aK_49 as ( no_diacritics K_49 )
    define K_50 as ( R1 'ni' next )
    define aK_50 as ( no_diacritics K_50 )
    define K_51 as (
        R1
        among (
            'asta' more 'esta' more 'ista' more 'psta' more 'rsta' more 'usta' more
            'aja' more 'aka' more 'ara' more 'ata' more 'cka' more 'eta' more
            'ika' more 'ima' more 'ita' more 'lja' more 'nja' more 'oja' more
            'ota' more 'ska' a_more 'sta' a_more 'uca' more 'uka' more 'uta' more
            'zna' more 'zva' more '{cv}ka' more '{sv}ka' more '{sv}ta' more
            'ga' not_o_more
        )
    )
    define aK_51 as ( no_diacritics K_51 )
    define K_52 as ( R1 'ur' next )
    define aK_52 as ( no_diacritics K_52 )
    define K_53 as ( R1 'staj' g_aio next )
    define aK_53 as ( no_diacritics K_53 )
    define K_54 as ( R1 'a' g_bcdefgjknrtuvcjcv next )
    define K_55 as (
        R1
        ( no_diacritics 'aj' g_cjstz next ) or
        ( 'aj' g_jtcvsvzv next )
    )
    define K_56 as (
        R1
        ( no_diacritics 'a' ( ( 'm' non-g_o next ) or ( g_bcdhjklnprsvz next ) ) ) or
        ( 'a' ( ( 'm' non-g_o next ) or ( '{cv}' g_inu next ) or ( g_bcdhjklnprsvzcjdjsvzv next ) ) )
    )
    define aK_56 as ( no_diacritics K_56 )
    define K_57 as ( R1 'sta' g_aio next )
    define aK_57 as ( no_diacritics K_57 )
    define K_58 as ( R1 'ta' next )
    define aK_58 as ( no_diacritics K_58 )
    define K_59 as ( R1 'inj' next )
    define aK_59 as ( no_diacritics K_59 )
    define K_60 as ( R1 'as' next )
    define aK_60 as ( no_diacritics K_60 )
    define K_61 as (
        R1
        among (
            'elji' more 'titi' more 'ulji' more 'aci' more 'avi' more 'eti' more
            'ici' a_more 'i{cv}i' more 'odi' more 'oji' more 'ovi' more
        )
    )
    define aK_61 as ( no_diacritics K_61 )
    define K_62 as (
        R1
        among (
            'jebi' more 'titi' more 'ari' more 'edi' more 'ici' a_more 'i{cv}i' more
            'usi' a_more 'u{sv}i' more
        )
    )
    define aK_62 as ( no_diacritics K_62 )
    define K_63 as (
        R1
        ( no_diacritics 'i' g_bcdlmprsz next ) or
        ( 'i' g_bdlmprscvsvzv next )
    )
    define aK_63 as ( no_diacritics K_63 )
    define K_64 as (
        R1
        ( no_diacritics 'luc' next ) or
        ( 'lu{cv}' next )
    )
    define aK_64 as ( no_diacritics K_64 )
    define K_65 as ( R1 'jeti' next )
    define aK_65 as ( no_diacritics K_65 )
    define K_66 as ( R1 'e' next )
    define K_67 as ( R1 'i' next )
    define K_68 as ( R1 'at' next )
    define K_69 as ( R1 'et' next )
    define aK_69 as ( no_diacritics K_69 )

    /* The rule lines, in order.  Each string carries its line's stem condition, so the among
       picks the ending whose stem matches the pattern; at most one ending of a line can (the
       generating script checks this), so if its stem is not valid the among fails and the next
       line is tried, as in the original.  An empty ending is the alternative after `or`. */
    define Strip as (
        // .+(s|š)k ijima|ijega|ijemu|ijem|ijim|ijih|ijoj|ijeg|iji|ije|ija|oga|ome|omu|ima|og|om|im|ih|oj|i|e|o|a|u
        ( [substring] among (
            'ijega' K_1 'ijemu' K_1 'ijima' K_1 'ijeg' K_1 'ijem' K_1 'ijih' K_1
            'ijim' K_1 'ijoj' K_1 'ija' K_1 'ije' K_1 'iji' K_1 'ima' K_1 'oga' K_1
            'ome' K_1 'omu' K_1 'ih' K_1 'im' K_1 'og' K_1 'oj' K_1 'om' K_1 'a' K_1
            'e' K_1 'i' K_1 'o' K_1 'u' K_1
          ) delete )
        or
        // .+(s|š)tv ima|om|o|a|u
        ( [substring] among (
            'ima' K_2 'om' K_2 'a' K_2 'o' K_2 'u' K_2
          ) delete )
        or
        // .+(t|m|p|r|g)anij ama|ima|om|a|u|e|i|
        ( [substring] among (
            'ama' K_3 'ima' K_3 'om' K_3 'a' K_3 'e' K_3 'i' K_3 'u' K_3
          ) delete )
        or K_3
        or
        // .+an inom|ina|inu|ine|ima|in|om|u|i|a|e|
        ( [substring] among (
            'inom' K_4 'ima' K_4 'ina' K_4 'ine' K_4 'inu' K_4 'in' K_4 'om' K_4
            'a' K_4 'e' K_4 'i' K_4 'u' K_4
          ) delete )
        or K_4
        or
        // .+in ima|ama|om|a|e|i|u|o|
        ( [substring] among (
            'ama' K_5 'ima' K_5 'om' K_5 'a' K_5 'e' K_5 'i' K_5 'o' K_5 'u' K_5
          ) delete )
        or K_5
        or
        // .+on ovima|ova|ove|ovi|ima|om|a|e|i|u|
        ( [substring] among (
            'ovima' K_6 'ima' K_6 'ova' K_6 'ove' K_6 'ovi' K_6 'om' K_6 'a' K_6
            'e' K_6 'i' K_6 'u' K_6
          ) delete )
        or K_6
        or
        // .+n ijima|ijega|ijemu|ijeg|ijem|ijim|ijih|ijoj|iji|ije|ija|iju|ima|ome|omu|oga|oj|om|ih|im|og|o|e|a|u|i|
        ( [substring] among (
            'ijega' K_7 'ijemu' K_7 'ijima' K_7 'ijeg' K_7 'ijem' K_7 'ijih' K_7
            'ijim' K_7 'ijoj' K_7 'ija' K_7 'ije' K_7 'iji' K_7 'iju' K_7 'ima' K_7
            'oga' K_7 'ome' K_7 'omu' K_7 'ih' K_7 'im' K_7 'og' K_7 'oj' K_7
            'om' K_7 'a' K_7 'e' K_7 'i' K_7 'o' K_7 'u' K_7
          ) delete )
        or K_7
        or
        // .+(a|e|u)ć oga|ome|omu|ega|emu|ima|oj|ih|om|eg|em|og|uh|im|e|a
        ( [substring] among (
            'ega' K_8 'emu' K_8 'ima' K_8 'oga' K_8 'ome' K_8 'omu' K_8 'eg' K_8
            'em' K_8 'ih' K_8 'im' K_8 'og' K_8 'oj' K_8 'om' K_8 'uh' K_8 'a' K_8
            'e' K_8
          ) delete )
        or
        // .+ugov ima|i|e|a
        ( [substring] among (
            'ima' K_9 'a' K_9 'e' K_9 'i' K_9
          ) delete )
        or
        // .+ug ama|om|a|e|i|u|o
        ( [substring] among (
